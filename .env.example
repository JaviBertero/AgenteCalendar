# App
APP_NAME=CalendarAgent
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret
BASE_URL=https://your-domain.com

# Google Gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# Groq (Llama 3.3 70B gratuito con Tool Calling en https://console.groq.com/keys)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=random-webhook-secret

# Google OAuth2
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://calendar:calendar@db:5432/calendar_agent

# Timezone default for users without preference
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Google Sheets Configuration (Tutores)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Tutores
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_API_KEY=
# SHEETS_COL_NAME=name
# SHEETS_COL_STATUS=status
# SHEETS_COL_EMAIL=email
# SHEETS_COL_WORKING_HOURS=working_hours

# Optional: Email del coordinador que tiene acceso a los calendarios de todos los tutores
COORDINATOR_EMAIL=

